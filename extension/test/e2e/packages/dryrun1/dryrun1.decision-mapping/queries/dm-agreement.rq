# dm-agreement: dryrun1.triage's triage-judge-agreement (7579351) reading the verdict under lab: as well (cockpit v0.5.4 ignores the package's aliases).
# judge-agreement: how often a person's spot checks (triage-spotcheck) side with each judge. Per signer and
# judge: ?agreed (verdicts naming that judge right), ?total (all of the signer's current verdicts, spec-unclear
# included), ?share = agreed / total. Only unreplaced spot checks (one per element and signer). $minVerdicts
# (optional, integer): rows only once the signer has at least that many verdicts; unbound, every row.
PREFIX nk:     <https://kton.dev/v/>
PREFIX lab:    <https://kton.dev/v/lab/>
PREFIX triage: <https://scinteco.com/ns/triage#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
SELECT ?signer ?judge ?agreed ?total ?share WHERE {
  {
    SELECT ?signer ?judge (SUM(?hit) AS ?agreed) (COUNT(?claim) AS ?total) WHERE {
      ?claim nk:predicate triage:spotchecks ; nk:signer ?signer ; lab:verdict|triage:verdict ?verdict .
      FILTER NOT EXISTS { ?claim nk:replacedBy ?newer }
      VALUES ?judge { "rule-judge" "second-model" }
      BIND(IF(STR(?verdict) = CONCAT(?judge, "-right"), 1, 0) AS ?hit)
    }
    GROUP BY ?signer ?judge
  }
  FILTER( ?total >= COALESCE(xsd:integer($minVerdicts), 0) )
  BIND(xsd:decimal(?agreed) / xsd:decimal(?total) AS ?share)
}
ORDER BY ?signer ?judge
