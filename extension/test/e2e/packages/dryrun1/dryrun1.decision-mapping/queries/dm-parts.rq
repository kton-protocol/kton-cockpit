# The unsettled elements in scope by product part, with the part's measured wrong-rate where n >= 30.
PREFIX nk: <https://kton.dev/v/>
PREFIX lab: <https://kton.dev/v/lab/>
PREFIX covx: <https://w3id.org/improve/coverage-extra#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?part ?unsettled ?rate ?stamp WHERE {
  { SELECT ?part (COUNT(DISTINCT ?e) AS ?unsettled) (SAMPLE(?s) AS ?stamp) WHERE {
      ?c nk:predicate covx:worklistItem ; lab:element ?e ; lab:inScope "true" ; lab:part ?part ; lab:stamp ?s } GROUP BY ?part }
  OPTIONAL { ?r nk:predicate covx:measuredRate ; lab:sample "covered" ; lab:dimension "part" ; lab:group ?part ; lab:n ?n ; lab:enough ?enough ; lab:rate ?rr ; lab:low ?lo ; lab:high ?hi }
  BIND(IF(!BOUND(?n), "not measured", IF(STR(?enough) = "true", CONCAT(STR(?rr), " % (", STR(?lo), "–", STR(?hi), ", n=", STR(?n), ")"), CONCAT("too few to measure (n=", STR(?n), ")"))) AS ?rate)
}
ORDER BY DESC(?unsettled)
