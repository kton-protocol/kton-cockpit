# evaluation-history: every version of one evaluation, replaced ones included, newest first (area.history,
# ktonpkg scope.HistoryShape: ?claim ?replaces ?replacedBy ?when). $record = the evaluation's IRI.
PREFIX nk:   <https://kton.dev/v/>
PREFIX qa:   <https://example.org/qa/>
PREFIX dct:  <http://purl.org/dc/terms/>
SELECT ?claim ?replaces ?replacedBy ?when WHERE {
  BIND(IRI($record) AS ?item)
  ?claim a nk:Claim ; nk:predicate qa:evaluationRecorded ; nk:about ?item ; dct:created ?when .
  OPTIONAL { ?claim nk:replacedBy ?replacedBy }
  OPTIONAL { ?claim nk:replaces ?replaces }
}
ORDER BY DESC(?when)
