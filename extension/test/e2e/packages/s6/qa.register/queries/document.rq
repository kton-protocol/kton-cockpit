# document: one document key in its latest state. $key = the document key (e.g. QA-SOP-10).
PREFIX nk:   <https://kton.dev/v/>
PREFIX qa:   <https://example.org/qa/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?document ?title ?revision ?state ?effectiveDate WHERE {
  ?claim a nk:Claim ; nk:predicate qa:documentState ; nk:about ?document ;
         qa:key ?k ; qa:title ?title ; qa:revision ?revision ; qa:state ?state .
  FILTER(STR(?k) = $key)
  FILTER NOT EXISTS { ?claim nk:replacedBy ?newer }
  OPTIONAL { ?claim qa:effectiveDate ?effectiveDate }
}
