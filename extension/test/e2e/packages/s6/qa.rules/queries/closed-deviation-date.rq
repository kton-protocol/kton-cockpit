# Rule QA-R-CLOSED-DATE: a closed deviation carries its closing date. Latest versions only.
# The one finding shape (C3.2): ?rule ?focus ?claim ?message.
PREFIX nk:   <https://kton.dev/v/>
PREFIX qa:   <https://example.org/qa/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?rule ?focus ?claim ?message WHERE {
  ?claim a nk:Claim ; nk:predicate qa:deviationRecorded ; nk:about ?focus ;
         qa:identifier ?identifier ; qa:status ?status .
  FILTER(STR(?status) = "closed")
  FILTER NOT EXISTS { ?claim nk:replacedBy ?newer }
  FILTER NOT EXISTS { ?claim qa:closedOn ?closedOn }
  BIND("QA-R-CLOSED-DATE" AS ?rule)
  BIND(CONCAT("Deviation ", STR(?identifier), " is closed without a closing date.") AS ?message)
}
ORDER BY ?focus
