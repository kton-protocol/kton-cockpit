# Rule QA-R-MAJOR-OWNER: a major or critical deviation names an owner. Latest versions only.
# The one finding shape (C3.2): ?rule ?focus ?claim ?message.
PREFIX nk:   <https://kton.dev/v/>
PREFIX qa:   <https://example.org/qa/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?rule ?focus ?claim ?message WHERE {
  ?claim a nk:Claim ; nk:predicate qa:deviationRecorded ; nk:about ?focus ;
         qa:identifier ?identifier ; qa:severity ?severity .
  FILTER(STR(?severity) IN ("major", "critical"))
  FILTER NOT EXISTS { ?claim nk:replacedBy ?newer }
  FILTER NOT EXISTS { ?claim qa:owner ?owner }
  BIND("QA-R-MAJOR-OWNER" AS ?rule)
  BIND(CONCAT("Deviation ", STR(?identifier), " is ", STR(?severity), " and names no owner.") AS ?message)
}
ORDER BY ?focus
