# deviation: one deviation for the record view (C3.2 record), latest version only.
# $record = the deviation's IRI (the claim's nk:about), bound by the shell from the list row's ?item.
PREFIX nk:   <https://kton.dev/v/>
PREFIX qa:   <https://example.org/qa/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?item ?claim ?identifier ?title ?severity ?status ?raisedBy ?owner ?closedOn ?signer ?signerName ?tier ?signed WHERE {
  BIND(IRI($record) AS ?item)
  ?claim a nk:Claim ; nk:predicate qa:deviationRecorded ; nk:about ?item ; dct:created ?signed ;
         nk:signer ?signer ; qa:identifier ?identifier ; qa:title ?title ; qa:severity ?severity ;
         qa:status ?status ; qa:raisedBy ?raisedBy .
  FILTER NOT EXISTS { ?claim nk:replacedBy ?newer }
  OPTIONAL { ?claim qa:owner ?owner }
  OPTIONAL { ?claim qa:closedOn ?closedOn }
  OPTIONAL { ?signer rdfs:label ?signerName }
  OPTIONAL { ?signer nk:tier ?tier }
}
