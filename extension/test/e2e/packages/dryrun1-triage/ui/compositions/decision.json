{
 "composition": "decision",
 "kind": "view",
 "subject": {
  "kind": "claim"
 },
 "vars": {
  "draw": {
   "type": "literal",
   "default": "gxp:0"
  },
  "minVerdicts": {
   "type": "literal",
   "default": "10"
  },
  "element": {
   "type": "literal",
   "default": "none"
  },
  "ruleCase": {
   "type": "literal",
   "default": "none"
  }
 },
 "parts": [
  {
   "id": "run",
   "heading": "This dry run",
   "blocks": [
    {
     "id": "run",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "text": "Dry run: dryrun1",
      "stamp": "test keys · does not settle 2c50ddd6"
     }
    }
   ]
  },
  {
   "id": "question",
   "heading": "Can the 5.0.0 mapping be the basis for G1 triage, and who settles the elements the judges disagree on?",
   "blocks": [
    {
     "id": "counts",
     "use": {
      "package": "@workbench",
      "block": "figures"
     },
     "query": "dm-figures",
     "empty": "show",
     "options": {
      "guard": "scope",
      "emptyText": "No data for dryrun1 (scope dryrun1.mapping)."
     }
    }
   ]
  },
  {
   "id": "trust",
   "heading": "How many covered elements are probably wrong",
   "blocks": [
    {
     "id": "estimate",
     "use": {
      "package": "@workbench",
      "block": "estimate"
     },
     "query": "dm-estimate",
     "empty": "show",
     "options": {
      "unit": "of covered elements",
      "emptyText": "No data for dryrun1: no measured rate in dryrun1.mapping."
     }
    }
   ]
  },
  {
   "id": "where",
   "heading": "Where the unsettled elements in your scope sit (GxP groups: verification's mapping from areas, for you to check)",
   "blocks": [
    {
     "id": "areas",
     "use": {
      "package": "@workbench",
      "block": "rows"
     },
     "query": "dm-areas",
     "empty": "show",
     "options": {
      "columns": [
       "gxp",
       "area",
       "unsettled",
       "rate",
       "stamp"
      ],
      "emptyText": "No data for dryrun1 (scope dryrun1.mapping)."
     }
    },
    {
     "id": "parts",
     "use": {
      "package": "@workbench",
      "block": "rows"
     },
     "query": "dm-parts",
     "empty": "show",
     "options": {
      "columns": [
       "part",
       "unsettled",
       "rate",
       "stamp"
      ],
      "emptyText": "No data for dryrun1 (scope dryrun1.mapping)."
     }
    }
   ]
  },
  {
   "id": "spot",
   "heading": "Spot check before you decide",
   "blocks": [
    {
     "id": "cards",
     "use": {
      "package": "@workbench",
      "block": "cards"
     },
     "query": "dm-spotchecks",
     "empty": "show",
     "options": {
      "title": "title",
      "fields": [
       "statement|Spec",
       "where|Area",
       "test|Test",
       "judge1|Judge 1",
       "judge2|Judge 2",
       "earlier|Earlier outcome"
      ],
      "target": "target",
      "choices": [
       "verdict=rule-judge-right|Rule judge is right",
       "verdict=second-model-right|Second model is right",
       "verdict=spec-unclear|Spec unclear → Wolfgang"
      ],
      "draws": [
       "gxp|Draw 4 more (GxP areas)",
       "any|Draw 4 more (anywhere)",
       "covered|Draw from covered (find the hidden errors)"
      ],
      "emptyText": "No data for dryrun1: nothing to draw.",
      "pick": "element|Evidence"
     },
     "params": {
      "draw": "var.draw"
     },
     "acts": [
      {
       "intent": "sign",
       "label": "Verdict",
       "control": "spotcheck",
       "fields": {
        "proposal": "subject.iri"
       }
      }
     ],
     "emits": {
      "draw": "draw",
      "pick": "element"
     }
    },
    {
     "id": "agreement",
     "use": {
      "package": "@workbench",
      "block": "rows"
     },
     "query": "triage-judge-agreement",
     "empty": "show",
     "options": {
      "emptyText": "No data for dryrun1 yet: your agreement with each judge shows after 10 verdicts."
     },
     "params": {
      "minVerdicts": "var.minVerdicts"
     }
    }
   ]
  },
  {
   "id": "evidence",
   "heading": "Evidence for the picked element (opened read-only at the stamped commit, the bytes checked against their hash; what you open is listed when you sign)",
   "blocks": [
    {
     "id": "evidence",
     "use": {
      "package": "@workbench",
      "block": "evidence"
     },
     "query": "dm-evidence",
     "empty": "show",
     "params": {
      "element": "var.element"
     },
     "options": {
      "ask": "element|Element id, e.g. ics1000#e2",
      "emptyText": "No data for dryrun1 on this element: pick one with “Evidence” on a card, or type its id."
     },
     "emits": {
      "element": "element"
     }
    },
    {
     "id": "artifacts",
     "use": {
      "package": "@workbench",
      "block": "evidence"
     },
     "query": "dm-artifacts",
     "empty": "show",
     "params": {
      "element": "var.element"
     },
     "options": {
      "emptyText": "No data for dryrun1: no recorded run of this element's tests in dryrun1.runs."
     }
    }
   ]
  },
  {
   "id": "capture",
   "heading": "Capture now: test-execution runs a test of the picked element on robert1, with a screenshot at its end (its answer shows here)",
   "blocks": [
    {
     "id": "captures",
     "use": {
      "package": "@workbench",
      "block": "requests"
     },
     "query": "dm-captures",
     "empty": "show",
     "params": {
      "element": "var.element"
     },
     "refine": {
      "poll": {
       "type": "integer",
       "default": "0"
      }
     },
     "options": {
      "title": "test",
      "fields": [
       "status|Status",
       "version|Version",
       "trace|Trace"
      ],
      "offer": "offer",
      "waiting": "waiting",
      "poll": "10",
      "propose": [
       "test=test",
       "reason="
      ],
      "done": "Requested; test-execution is asked by the userinterface lane",
      "nudge": "./send userinterface requests area=test-execution title=\"capture now: {test}\" text=\"request claim {claim}; test {test}\" why=\"MH's decision view\"",
      "emptyText": "No data for dryrun1 on this element: none of its tests was run in dryrun1.runs (pick one with “Evidence” on a card)."
     },
     "acts": [
      {
       "intent": "sign",
       "label": "Capture now",
       "control": "capture",
       "fields": {
        "proposal": "subject.iri"
       }
      }
     ]
    }
   ]
  },
  {
   "id": "rules",
   "heading": "Where the disagreement comes from: rule cases still open",
   "blocks": [
    {
     "id": "rulecases",
     "use": {
      "package": "@workbench",
      "block": "cards"
     },
     "query": "dm-rule-cases",
     "empty": "show",
     "options": {
      "title": "title",
      "fields": [
       "effects|Each answer resolves",
       "settled|Your answer"
      ],
      "target": "case",
      "choices": [
       "answer=asserted|Asserted",
       "answer=exercised|Exercised",
       "answer=no-relation|No relation"
      ],
      "pick": "ruleCase|Show examples",
      "emptyText": "No data for dryrun1: no rule cases in dryrun1.mapping."
     },
     "acts": [
      {
       "intent": "sign",
       "label": "Settle",
       "control": "rule-case"
      }
     ],
     "emits": {
      "pick": "ruleCase"
     }
    },
    {
     "id": "examples",
     "use": {
      "package": "@workbench",
      "block": "cards"
     },
     "query": "dm-rule-examples",
     "empty": "show",
     "params": {
      "ruleCase": "var.ruleCase"
     },
     "options": {
      "title": "title",
      "fields": [
       "statement|Spec",
       "where|Area",
       "judge1|Judge 1",
       "judge2|Judge 2"
      ],
      "pick": "element|Evidence (shown under “Evidence” above)",
      "emptyText": "No data for dryrun1 for this rule case: pick one with “Show examples”."
     },
     "emits": {
      "pick": "element"
     }
    }
   ]
  },
  {
   "id": "options",
   "heading": "Options, compared on the same axes",
   "blocks": [
    {
     "id": "options",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "text": "The options a, b and c are in the proposal's text. Their axes (cost, who works, evidence after, residual) are not data yet, so they are not compared here."
     }
    }
   ]
  },
  {
   "id": "sign",
   "heading": "Your decision is recorded with what you looked at",
   "blocks": [
    {
     "id": "summary",
     "use": {
      "package": "@workbench",
      "block": "figures"
     },
     "query": "dm-summary",
     "empty": "show",
     "options": {
      "propose": [
       "lookedAt=lookedAt"
      ],
      "emptyText": "No data for dryrun1: nothing recorded for this dry run."
     },
     "params": {
      "proposal": "subject.iri"
     },
     "acts": [
      {
       "intent": "record",
       "label": "Ask a question about this",
       "control": "question"
      },
      {
       "intent": "sign",
       "label": "Choose and sign",
       "control": "decides"
      }
     ]
    }
   ]
  }
 ]
}
