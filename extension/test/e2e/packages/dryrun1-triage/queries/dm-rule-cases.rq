# The open rule cases (6, 9, 10): what each answer would resolve, and the answer the window's person signed (if any).
# Run: effects from "dryrun1.mapping", answers from "dryrun1.triage". ?ruleCase: the number (the examples' pick).
# ?effects: one entry per answer, "answer|covered|exercisedOnly|gap|resolved" joined by ";" (the cards block's effects
# table); ?touched: the elements the case touches. Answers are read under triage: (this package's aliases) and lab: (a
# cockpit that does not apply them).
# ?stampLabel ?stampFull ?stampScope: where the numbers come from (MH 20.11.): verification's covx:sourceStamp claim for
# the data set (the number's template) and stamp, e.g. "mapping round 9 · b610b5c6" with the full view hash; the scope
# names it when no round stamps it.
PREFIX triage: <https://scinteco.com/ns/triage#>
PREFIX nk: <https://kton.dev/v/>
PREFIX lab: <https://kton.dev/v/lab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX covx: <https://w3id.org/improve/coverage-extra#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?case ?ruleCase ?title ?effects ?touched ?settled ?stamp ?stampLabel ?stampFull ?stampScope WHERE {
  { SELECT ?sc ?ruleCase (GROUP_CONCAT(CONCAT(STR(?answer), "|", STR(?toCovered), "|", STR(?toExercisedOnly), "|", STR(?toGap), "|", STR(?resolved)); separator=";") AS ?effects) (MAX(xsd:integer(?t)) AS ?touched) (SAMPLE(?s) AS ?stamp) (SAMPLE(?tm) AS ?tmpl) WHERE {
      ?sc rdfs:label "dryrun1.mapping" .
      ?c nk:scope ?sc ; nk:predicate covx:ruleCaseEffect ; lab:ruleCase ?ruleCase ; lab:answer ?answer ; lab:touched ?t ; lab:resolved ?resolved ;
         lab:toCovered ?toCovered ; lab:toExercisedOnly ?toExercisedOnly ; lab:toGap ?toGap ; lab:stamp ?s . OPTIONAL { ?c nk:template ?tm } } GROUP BY ?sc ?ruleCase }
  BIND(IRI(CONCAT("https://w3id.org/improve/coverage-extra#rule-case-", STR(?ruleCase))) AS ?case)
  BIND(CONCAT("Rule case ", STR(?ruleCase)) AS ?title)
  OPTIONAL { ?ts rdfs:label "dryrun1.triage" . ?t nk:scope ?ts ; nk:predicate triage:ruleCase ; nk:about ?case ; triage:answer|lab:answer ?a . FILTER NOT EXISTS { ?t nk:replacedBy ?n }
             ?sm rdfs:label "dryrun1.mapping" . ?e nk:scope ?sm ; nk:predicate covx:ruleCaseEffect ; lab:ruleCase ?ruleCase ; lab:answer ?ea ; lab:resolved ?r . FILTER(STR(?ea) = STR(?a)) }
  BIND(IF(BOUND(?a), CONCAT("settled: ", STR(?a), " — resolves ", STR(?r)), "open") AS ?settled)
  OPTIONAL { ?ss nk:scope ?sc ; nk:predicate covx:sourceStamp ; lab:dataSet ?ds ; lab:stamp ?ssStamp ; lab:label ?stampLabel .
    FILTER(STR(?ds) = STR(?tmpl) && STR(?ssStamp) = STR(?stamp)) FILTER NOT EXISTS { ?ss nk:replacedBy ?ssNew } OPTIONAL { ?ss lab:viewSha256 ?stampFull } }
  BIND("dryrun1.mapping" AS ?stampScope)
}
ORDER BY xsd:integer(?ruleCase)
