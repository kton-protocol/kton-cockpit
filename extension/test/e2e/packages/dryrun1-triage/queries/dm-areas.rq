# Where the unsettled elements in scope sit, by GxP group (verification's mapping from areas, for MH to check) and area,
# GxP groups first, with the measured wrong-rate of covered elements in that area where n >= 30. Run: "dryrun1.mapping".
PREFIX nk: <https://kton.dev/v/>
PREFIX lab: <https://kton.dev/v/lab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX covx: <https://w3id.org/improve/coverage-extra#>
SELECT ?gxp ?area ?unsettled ?rate ?stamp WHERE {
  ?sc rdfs:label "dryrun1.mapping" .
  { SELECT ?sc ?gxp ?area (COUNT(DISTINCT ?e) AS ?unsettled) (SAMPLE(?s) AS ?stamp) WHERE {
      ?sc rdfs:label "dryrun1.mapping" . ?c nk:scope ?sc ; nk:predicate covx:worklistItem ; lab:element ?e ; lab:inScope "true" ; lab:gxp ?gxp ; lab:area ?area ; lab:stamp ?s } GROUP BY ?sc ?gxp ?area }
  OPTIONAL { ?r nk:scope ?sc ; nk:predicate covx:measuredRate ; lab:sample "covered" ; lab:dimension "area" ; lab:group ?area ; lab:n ?n ; lab:enough ?enough ; lab:rate ?rr ; lab:low ?lo ; lab:high ?hi }
  BIND(IF(!BOUND(?n), "not measured", IF(STR(?enough) = "true", CONCAT(STR(?rr), " % (", STR(?lo), "–", STR(?hi), ", n=", STR(?n), ")"), CONCAT("too few to measure (n=", STR(?n), ")"))) AS ?rate)
}
ORDER BY (?gxp = "none") ?gxp DESC(?unsettled)
