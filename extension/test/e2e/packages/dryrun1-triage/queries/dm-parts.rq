# The unsettled elements in scope by product part, with the part's measured wrong-rate of covered elements. ?rate ?low ?high (percent) and ?n
# as numbers, ?enough "true" where n >= 30 (else the rate is too few to measure); all unbound where nothing was measured.
# Run: "dryrun1.mapping".
# ?stampLabel ?stampFull ?stampScope: where the numbers come from (MH 20.11.): verification's covx:sourceStamp claim for
# the data set (the number's template) and stamp, e.g. "mapping round 9 · b610b5c6" with the full view hash; the scope
# names it when no round stamps it.
PREFIX nk: <https://kton.dev/v/>
PREFIX lab: <https://kton.dev/v/lab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX covx: <https://w3id.org/improve/coverage-extra#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?part ?unsettled ?rate ?low ?high ?n ?enough ?stamp ?stampLabel ?stampFull ?stampScope WHERE {
  ?sc rdfs:label "dryrun1.mapping" .
  { SELECT ?sc ?part (COUNT(DISTINCT ?e) AS ?unsettled) (SAMPLE(?s) AS ?stamp) (SAMPLE(?tm) AS ?tmpl) WHERE {
      ?sc rdfs:label "dryrun1.mapping" . ?c nk:scope ?sc ; nk:predicate covx:worklistItem ; lab:element ?e ; lab:inScope "true" ; lab:part ?part ; lab:stamp ?s . OPTIONAL { ?c nk:template ?tm } } GROUP BY ?sc ?part }
  OPTIONAL { ?r nk:scope ?sc ; nk:predicate covx:measuredRate ; lab:sample "covered" ; lab:dimension "part" ; lab:group ?part ; lab:n ?rn ; lab:enough ?re ; lab:rate ?rr ; lab:low ?lo ; lab:high ?hi }
  BIND(xsd:decimal(?rr) AS ?rate) BIND(xsd:decimal(?lo) AS ?low) BIND(xsd:decimal(?hi) AS ?high) BIND(xsd:integer(?rn) AS ?n) BIND(STR(?re) AS ?enough)
  OPTIONAL { ?ss nk:scope ?sc ; nk:predicate covx:sourceStamp ; lab:dataSet ?ds ; lab:stamp ?ssStamp ; lab:label ?stampLabel .
    FILTER(STR(?ds) = STR(?tmpl) && STR(?ssStamp) = STR(?stamp)) FILTER NOT EXISTS { ?ss nk:replacedBy ?ssNew } OPTIONAL { ?ss lab:viewSha256 ?stampFull } }
  BIND("dryrun1.mapping" AS ?stampScope)
}
ORDER BY DESC(?unsettled)
