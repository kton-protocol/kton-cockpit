# ranked-before-assigned: an assignment (triage-assigns) names a round that was ranked first: some unreplaced
# triage-ranks claim of the same round created no later than the assignment. A finding otherwise.
PREFIX nk:     <https://kton.dev/v/>
PREFIX triage: <https://scinteco.com/ns/triage#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
SELECT ?rule ?focus ?claim ?message ?round WHERE {
  BIND("ranked-before-assigned" AS ?rule)
  ?claim nk:predicate triage:assigns ; nk:about ?focus ; triage:round ?round ; dct:created ?ac .
  FILTER NOT EXISTS { ?claim nk:replacedBy ?newer }
  FILTER NOT EXISTS {
    ?rk nk:predicate triage:ranks ; triage:round ?round ; dct:created ?rc .
    FILTER NOT EXISTS { ?rk nk:replacedBy ?rn }
    FILTER( xsd:dateTime(STR(?rc)) <= xsd:dateTime(STR(?ac)) )
  }
  BIND(CONCAT("assigned before the round ", STR(?round), " was ranked (ranked-before-assigned)") AS ?message)
}
ORDER BY ?focus
