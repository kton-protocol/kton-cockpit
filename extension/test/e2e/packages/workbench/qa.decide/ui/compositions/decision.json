{
 "composition": "decision",
 "kind": "view",
 "subject": {
  "kind": "claim"
 },
 "vars": {
  "element": {
   "type": "literal",
   "default": "none"
  }
 },
 "parts": [
  {
   "id": "run",
   "heading": "Trial",
   "blocks": [
    {
     "id": "run",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "banner",
      "text": "Trial: run-a",
      "stamp": "test keys · does not settle 0a1b2c3d",
      "chipTip": "the decision this trial is about; its signatures go into trial scopes"
     }
    },
    {
     "id": "head",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "head",
      "eyebrow": "Decision",
      "text": "Is the mapping a basis for the next step?",
      "lede": "Check the summary, judge the spot checks, open the evidence, then decide."
     }
    }
   ]
  },
  {
   "id": "top",
   "heading": "Summary and spot check",
   "layout": {
    "type": "columns",
    "columns": [
     "1fr",
     "1fr"
    ],
    "narrow": "stack"
   },
   "parts": [
    {
     "id": "summary",
     "heading": "Summary",
     "blocks": [
      {
       "id": "sub",
       "use": {
        "package": "@workbench",
        "block": "notice"
       },
       "options": {
        "tone": "sub",
        "text": "Unsettled items, and how many covered items are probably wrong"
       }
      },
      {
       "id": "counts",
       "use": {
        "package": "@workbench",
        "block": "figures"
       },
       "query": "figures",
       "empty": "show",
       "options": {
        "display": "tiles",
        "guard": "scope",
        "relation": "1+3=2",
        "scopeLabels": [
         "in scope (as agreed)|in scope",
         "all judged|all judged",
         "outside your scope|outside"
        ],
        "emptyText": "No data for run-a (scope w.data).",
        "emptyHow": "The counts come from the item claims in w.data."
       }
      },
      {
       "id": "estimate",
       "use": {
        "package": "@workbench",
        "block": "estimate"
       },
       "query": "estimate",
       "empty": "show",
       "options": {
        "title": "Probably wrong among covered items",
        "unit": "covered items",
        "chart": "range",
        "domain": "0,8",
        "reported": "yes",
        "repro": "yes",
        "emptyText": "No data for run-a: no measured rate in w.data."
       }
      }
     ]
    },
    {
     "id": "spot",
     "heading": "Spot check",
     "blocks": [
      {
       "id": "sub",
       "use": {
        "package": "@workbench",
        "block": "notice"
       },
       "options": {
        "tone": "sub",
        "text": "Items drawn from the groups. Judge each before you decide."
       }
      },
      {
       "id": "cards",
       "use": {
        "package": "@workbench",
        "block": "cards"
       },
       "query": "spotchecks",
       "empty": "show",
       "options": {
        "title": "element",
        "group": "group",
        "badge": "earlier|earlier: ",
        "quote": "statement",
        "fields": [
         "where|Area",
         "testName|Test"
        ],
        "locs": [
         "testName=testLoc"
        ],
        "compare": [
         "judge1|Judge 1",
         "judge2|Judge 2"
        ],
        "target": "target",
        "choices": [
         "verdict=first-right|Judge 1 is right",
         "verdict=second-right|Judge 2 is right",
         "verdict=unclear|Unclear"
        ],
        "choiceLegend": "Your verdict",
        "layout": "pager",
        "emptyText": "No data for run-a: nothing to draw.",
        "pick": "element|Show evidence"
       },
       "acts": [
        {
         "intent": "sign",
         "label": "Sign verdict…",
         "control": "spotcheck",
         "fields": {
          "proposal": "subject.iri"
         }
        }
       ],
       "emits": {
        "pick": "element"
       }
      }
     ]
    }
   ]
  },
  {
   "id": "where",
   "heading": "Where the unsettled items sit",
   "layout": {
    "type": "tabs"
   },
   "blocks": [
    {
     "id": "sub",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "sub",
      "text": "Your scope, by area and by part.",
      "nav": "Where"
     }
    }
   ],
   "parts": [
    {
     "id": "by-area",
     "heading": "By area",
     "blocks": [
      {
       "id": "areas",
       "use": {
        "package": "@workbench",
        "block": "rows"
       },
       "query": "areas",
       "empty": "show",
       "options": {
        "columns": [
         "area",
         "unsettled",
         "rate",
         "low",
         "n"
        ],
        "labels": [
         "area|Area",
         "unsettled|Unsettled"
        ],
        "group": "group",
        "groupLabels": [
         "none|No group"
        ],
        "groupSum": "unsettled",
        "range": "rate,low,high,n",
        "scale": "0,20,5",
        "measurable": "enough",
        "stamp": "section",
        "emptyText": "No data for run-a (scope w.data)."
       }
      }
     ]
    },
    {
     "id": "by-part",
     "heading": "By part",
     "blocks": [
      {
       "id": "parts",
       "use": {
        "package": "@workbench",
        "block": "rows"
       },
       "query": "parts",
       "empty": "show",
       "options": {
        "columns": [
         "part",
         "unsettled",
         "rate",
         "low",
         "n"
        ],
        "labels": [
         "part|Part",
         "unsettled|Unsettled"
        ],
        "range": "rate,low,high,n",
        "scale": "0,20,5",
        "measurable": "enough",
        "total": "unsettled",
        "stamp": "section",
        "emptyText": "No data for run-a (scope w.data)."
       }
      }
     ]
    }
   ]
  },
  {
   "id": "evidence",
   "heading": "Evidence",
   "blocks": [
    {
     "id": "sub",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "sub",
      "text": "Opened read-only at the stamped commit, bytes checked against their hash. What you open is listed when you sign."
     }
    },
    {
     "id": "evidence",
     "use": {
      "package": "@workbench",
      "block": "evidence"
     },
     "query": "evidence",
     "empty": "show",
     "params": {
      "element": "var.element"
     },
     "options": {
      "ask": "element|e.g. item-1#e2",
      "askHint": "or “Show evidence” on a spot-check card",
      "emptyText": "No data for run-a on this element",
      "emptyHow": "Pick one with “Show evidence” on a spot-check card, or type its id."
     },
     "emits": {
      "element": "element"
     }
    },
    {
     "id": "artifacts",
     "use": {
      "package": "@workbench",
      "block": "evidence"
     },
     "query": "artifacts",
     "empty": "show",
     "params": {
      "element": "var.element"
     },
     "options": {
      "title": "Recorded runs of this element's tests",
      "runs": "table",
      "collapsePassing": "yes",
      "emptyText": "No data for run-a: no recorded run of this element's tests.",
      "emptyHow": "Runs come from w.runs."
     }
    }
   ]
  },
  {
   "id": "capture",
   "heading": "Capture now",
   "blocks": [
    {
     "id": "sub",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "sub",
      "text": "A test of the picked element runs again with a screenshot at its end; its answer shows here."
     }
    },
    {
     "id": "captures",
     "use": {
      "package": "@workbench",
      "block": "requests"
     },
     "query": "captures",
     "empty": "show",
     "params": {
      "element": "var.element"
     },
     "refine": {
      "poll": {
       "type": "integer",
       "default": "0"
      }
     },
     "options": {
      "title": "test",
      "fields": [
       "status|Status"
      ],
      "offer": "offer",
      "waiting": "waiting",
      "poll": "5",
      "propose": [
       "test=test",
       "reason="
      ],
      "done": "Requested",
      "nudge": "./send lane-a requests area=area-b title=\"capture now: {test}\" text=\"request claim {claim}; test {test}\" why=\"the decision view\"",
      "emptyText": "No data for run-a on this element: none of its tests was run",
      "emptyHow": "Pick an element with “Show evidence” on a spot-check card."
     },
     "acts": [
      {
       "intent": "sign",
       "label": "Capture now",
       "control": "capture",
       "fields": {
        "proposal": "subject.iri"
       }
      }
     ]
    }
   ]
  },
  {
   "id": "units",
   "heading": "Recorded units",
   "blocks": [
    {
     "id": "units",
     "use": {
      "package": "@workbench",
      "block": "rows"
     },
     "query": "units",
     "empty": "show",
     "options": {
      "columns": [
       "test",
       "result",
       "run"
      ],
      "target": "claim",
      "propose": [
       "test=test"
      ],
      "choices": [
       "reason=|Request rerun",
       "reason=capture mode|Request rerun (capture mode)"
      ],
      "nudge": "./send lane-a requests area=area-b title=\"rerun: {test}\" text=\"rerun request claim {claim}; test {test}\" why=\"row acts\""
     },
     "acts": [
      {
       "intent": "record",
       "label": "Request rerun",
       "control": "rerun-request",
       "from": {
        "package": "qa.owner",
        "at": "1",
        "head": "@OWNER_HEAD@"
       }
      }
     ]
    }
   ]
  },
  {
   "id": "history",
   "heading": "Decisions on an element",
   "blocks": [
    {
     "id": "sub",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "sub",
      "text": "Every decision on each element, oldest first; a later one by someone else that differs is flagged. Cited artifacts open hash checked."
     }
    },
    {
     "id": "notes",
     "use": {
      "package": "@workbench",
      "block": "rows"
     },
     "query": "history",
     "options": {
      "columns": [
       "element",
       "who",
       "at",
       "verdict",
       "text",
       "cites",
       "citesNote",
       "differs"
      ],
      "labels": [
       "at|When",
       "cites|Cited",
       "citesNote|Not resolved",
       "differs|Differs"
      ],
      "evidence": "cites",
      "cite": "cite-artifacts",
      "differs": "element|who|at|verdict",
      "emptyText": "No decision on an element yet.",
      "citeColumns": [
       "text"
      ],
      "citeStructured": "evidence",
      "differsLead": [
       "Lead"
      ]
     }
    }
   ]
  },
  {
   "id": "sign",
   "heading": "Decide",
   "blocks": [
    {
     "id": "sub",
     "use": {
      "package": "@workbench",
      "block": "notice"
     },
     "options": {
      "tone": "sub",
      "text": "Your decision is recorded with what you looked at."
     }
    },
    {
     "id": "summary",
     "use": {
      "package": "@workbench",
      "block": "figures"
     },
     "query": "summary",
     "empty": "show",
     "params": {
      "proposal": "subject.iri"
     },
     "options": {
      "display": "tiles",
      "notes": [
       "spot checks judged|this trial",
       "captures requested|this trial"
      ],
      "propose": [
       "lookedAt=lookedAt"
      ],
      "emptyText": "No data for run-a: nothing recorded for this trial."
     },
     "acts": [
      {
       "intent": "sign",
       "label": "Choose and sign…",
       "control": "decides"
      }
     ]
    }
   ]
  }
 ]
}
