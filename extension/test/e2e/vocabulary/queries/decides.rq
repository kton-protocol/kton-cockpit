# Every decides claim, with its signer's label and tier: the shell counts it as a decision only when a
# person signed it.
PREFIX nk:   <https://kton.dev/v/>
PREFIX t:    <https://example.org/workbench-e2e/>
PREFIX lab:  <https://kton.dev/v/lab/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?d ?answers ?outcome ?choice ?by ?byTier ?when WHERE {
  ?d nk:predicate t:decides ; lab:answers ?answers ; lab:outcome ?outcome ; nk:signer ?s ; dct:created ?when .
  OPTIONAL { ?d lab:choice ?choice }
  OPTIONAL { ?s rdfs:label ?by }
  OPTIONAL { ?s nk:tier ?byTier }
}
