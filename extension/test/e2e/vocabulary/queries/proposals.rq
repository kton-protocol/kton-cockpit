# Proposals: a question with options that a person decides. The shell, not this query, decides which
# proposals are still open: only a decides signed by a person closes one (review check 7).
PREFIX nk:   <https://kton.dev/v/>
PREFIX t:    <https://example.org/workbench-e2e/>
PREFIX lab:  <https://kton.dev/v/lab/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?msg ?type ?area ?title ?text ?why ?options ?recommended ?from ?fromTier ?s ?when WHERE {
  BIND(t:proposes AS ?type)
  ?msg nk:predicate t:proposes ; lab:area ?area ; lab:title ?title ; lab:text ?text ; lab:why ?why ;
       lab:options ?options ; nk:signer ?s ; dct:created ?when .
  OPTIONAL { ?msg lab:recommended ?recommended }
  OPTIONAL { ?s rdfs:label ?from }
  OPTIONAL { ?s nk:tier ?fromTier }
} ORDER BY ?when ?msg
