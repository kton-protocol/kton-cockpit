# Messages: requests and announcements, with their signer (?s), its label and its tier.
PREFIX nk:   <https://kton.dev/v/>
PREFIX t:    <https://example.org/workbench-e2e/>
PREFIX lab:  <https://kton.dev/v/lab/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?msg ?kind ?area ?title ?text ?why ?from ?fromTier ?s ?when ?about WHERE {
  VALUES ?kind { t:requests t:announces }
  ?msg nk:predicate ?kind ; lab:area ?area ; lab:title ?title ; lab:text ?text ; nk:signer ?s ; dct:created ?when .
  OPTIONAL { ?msg lab:why ?why }
  OPTIONAL { ?msg nk:about ?about }
  OPTIONAL { ?s rdfs:label ?from }
  OPTIONAL { ?s nk:tier ?fromTier }
}
