#!/usr/bin/env python3
"""A story heuristic (recorder/watch/heuristics.go): NONMEM run folders.

A folder <run>/ holding <run>.ctl (or .mod) and <run>.lst is taken as one run of nmfe on the
control stream: inputs the control stream and the dataset its $DATA names, outputs the .lst and
what NONMEM writes beside it (.ext .phi .cov .cor .coi .xml and the $TABLE files). Only runs whose
.lst is newer than the control stream are proposed: an older .lst came from another version.
Register it in the story (Reconstruct with… → register), or PUT /api/heuristics {name, path}.
"""
import json
import os
import re
import sys

req = json.load(sys.stdin)
files = {f["path"]: f for f in req["files"]}
out = []
for p, f in files.items():
    m = re.match(r"^(.*/)?([^/]+)\.(ctl|mod)$", p)
    if not m:
        continue
    d, run = m.group(1) or "", m.group(2)
    lst = f"{d}{run}.lst"
    if lst not in files or files[lst]["mtime_ns"] < f["mtime_ns"]:
        continue
    try:
        text = open(os.path.join(req["repo"], p), encoding="utf-8", errors="replace").read()
    except OSError:
        continue
    inputs = [p]
    data = re.search(r"^\s*\$DATA\s+(\S+)", text, re.M | re.I)
    if data:
        for cand in (os.path.normpath(d + data.group(1)), os.path.normpath(data.group(1))):
            cand = cand.replace(os.sep, "/")
            if cand in files:
                inputs.append(cand)
                break
    outputs = [lst] + [f"{d}{run}.{x}" for x in ("ext", "phi", "cov", "cor", "coi", "xml") if f"{d}{run}.{x}" in files]
    for t in re.findall(r"^\s*\$TABLE\b.*?\bFILE\s*=\s*(\S+)", text, re.M | re.I):
        if f"{d}{t}" in files:
            outputs.append(f"{d}{t}")
    out.append({"inputs": inputs, "outputs": outputs, "cmd": f"nmfe75 {run}.{m.group(3)} {run}.lst (in {d or './'})",
                "note": f"{run}.lst is newer than the control stream"})
json.dump(out, sys.stdout)
